  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#787878",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "constant.character.escape",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ae98b8"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ae98b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ae98b8"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#888480"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#d8d8d8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#ebebeb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import/preprocessor",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.other.directive"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#606060"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#ebebeb"
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "support.type",
        "support.class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#b0b0b0"
      }
    },
    {
      "name": "Type qualifiers",
      "scope": [
        "storage.modifier",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#d8d8d8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#c8c8c8"
      }
    },
    {
